{% extends 'pages/_base.jinja' %}


{% block content %}

  <header id="form_header">
    <h2>Add Task</h2>
  </header>

  <form method ="post" action="/task/new">
    <div class="form">

       <label>

        Topic:
        <input type="text" name="topic" required>
        
      </label>

      <label>

        Name:
        <input type="text" name="name" required>

      </label>

      <label>

        Description:
        <input type="text" name="description" required>

      </label>

      <label>

        Estimated Task Time:
        <input type="text" name="est_time" required>

      </label>

      <label>

        Date To Be Completed:
        <input type="text" name="complete_by" required>

      </label>

      <label>

        Urgency:
        <input type="int" name="urgency" required>

      </label>

    </div>
    <button id="add_task_button">Add</button>
    <a id="cancel_task_button" href="/">Cancel</a>

  </form>

{% endblock %}

